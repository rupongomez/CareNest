<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CareNest - Appointment Confirmed</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7f9;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
            width: 100%;
            background-color: #f4f7f9;
            padding: 40px 16px;
        ">
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
                        max-width: 560px;
                        background-color: #ffffff;
                        border-radius: 12px;
                        overflow: hidden;
                        border: 1px solid #e5e7eb;
                    ">

                    <!-- Header -->
                    <tr>
                        <td style="
                            padding: 28px 32px;
                            border-bottom: 1px solid #e5e7eb;
                        ">
                            <div style="
                                font-size: 24px;
                                font-weight: 700;
                                color: #0f766e;
                                margin-bottom: 4px;
                            ">
                                CareNest
                            </div>

                            <div style="
                                font-size: 13px;
                                color: #6b7280;
                            ">
                                Online Medical Management System
                            </div>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 32px;">

                            <!-- Success Icon -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center"
                                style="margin-bottom: 24px;">
                                <tr>
                                    <td align="center" valign="middle" style="
                                            width: 64px;
                                            height: 64px;
                                            background-color: #ecfdf5;
                                            border: 1px solid #a7f3d0;
                                            border-radius: 50%;
                                            font-size: 30px;
                                            font-weight: 700;
                                            color: #059669;
                                        ">
                                        ✓
                                    </td>
                                </tr>
                            </table>

                            <!-- Heading -->
                            <h1 style="
                                margin: 0 0 16px;
                                text-align: center;
                                font-size: 26px;
                                line-height: 1.3;
                                font-weight: 700;
                                color: #111827;
                            ">
                                Appointment Confirmed
                            </h1>

                            <!-- Patient Name -->
                            <p style="
                                margin: 0 0 20px;
                                text-align: center;
                                font-size: 16px;
                                line-height: 1.6;
                                color: #374151;
                            ">
                                Hello <%= name %>,
                            </p>

                            <!-- Main Message -->
                            <p style="
                                margin: 0;
                                text-align: center;
                                font-size: 16px;
                                line-height: 1.6;
                                color: #374151;
                            ">
                                Your appointment has been successfully
                                confirmed. Your payment was received and
                                your appointment is now reserved.
                            </p>

                            <!-- Confirmation Notice -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
                                    margin-top: 28px;
                                    background-color: #ecfdf5;
                                    border: 1px solid #a7f3d0;
                                    border-radius: 8px;
                                ">
                                <tr>
                                    <td style="
                                        padding: 20px;
                                        font-size: 14px;
                                        line-height: 1.7;
                                        color: #065f46;
                                    ">
                                        <strong style="
                                            display: block;
                                            margin-bottom: 6px;
                                            font-size: 15px;
                                        ">
                                            Payment successful
                                        </strong>

                                        Your appointment is confirmed and
                                        your payment has been successfully
                                        processed through bKash.
                                    </td>
                                </tr>
                            </table>

                            <!-- Invoice Notice -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
                                    margin-top: 24px;
                                    background-color: #f9fafb;
                                    border-radius: 8px;
                                ">
                                <tr>
                                    <td style="
                                        padding: 18px;
                                        font-size: 14px;
                                        line-height: 1.6;
                                        color: #6b7280;
                                        text-align: center;
                                    ">
                                        <strong style="color: #374151;">
                                            Your invoice is attached
                                        </strong>
                                        <br>
                                        A PDF invoice containing your
                                        appointment and payment details
                                        is attached to this email.
                                        Please keep it for your records.
                                    </td>
                                </tr>
                            </table>

                            <!-- Reminder -->
                            <p style="
                                margin: 28px 0 0;
                                padding-top: 24px;
                                border-top: 1px solid #e5e7eb;
                                text-align: center;
                                font-size: 14px;
                                line-height: 1.6;
                                color: #6b7280;
                            ">
                                Please make sure to join your appointment
                                at your assigned joining time. You can find
                                your appointment details and meeting link
                                in your CareNest dashboard.
                            </p>

                            <!-- Closing -->
                            <p style="
                                margin: 20px 0 0;
                                text-align: center;
                                font-size: 14px;
                                line-height: 1.6;
                                color: #6b7280;
                            ">
                                Thank you for choosing CareNest.
                                We wish you a healthy day!
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="
                            padding: 20px 32px;
                            background-color: #f9fafb;
                            text-align: center;
                        ">
                            <p style="
                                margin: 0 0 6px;
                                font-size: 13px;
                                color: #6b7280;
                            ">
                                © <%= new Date().getFullYear() %> CareNest
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                line-height: 1.5;
                                color: #9ca3af;
                            ">
                                This is an automated appointment
                                confirmation. Please do not reply to
                                this email.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>
```