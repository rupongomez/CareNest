<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your New Verification Code - CareNest</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: Arial, Helvetica, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f3f4f6; padding: 40px 15px;">
        <tr>
            <td align="center">


                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="max-width: 600px; background-color: #ffffff; border-radius: 10px; overflow: hidden; border: 1px solid #e5e7eb;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background-color: #0f766e; padding: 28px 20px;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: 700;">
                                CareNest
                            </h1>
                            <p style="margin: 7px 0 0; color: #ccfbf1; font-size: 14px;">
                                Online Medical Management System
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 35px 35px 30px;">

                            <h2 style="margin: 0 0 15px; color: #111827; font-size: 22px; text-align: center;">
                                Your New Verification Code
                            </h2>

                            <p
                                style="margin: 0 0 25px; color: #6b7280; font-size: 14px; line-height: 22px; text-align: center;">
                                A new verification code has been requested for
                            </p>

                            <!-- Email -->
                            <p
                                style="margin: 0 0 25px; color: #0f766e; font-size: 15px; font-weight: 600; text-align: center;">
                                <%= email %>
                            </p>

                            <!-- OTP -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center">
                                        <div
                                            style="display: inline-block; background-color: #f0fdfa; border: 1px solid #99f6e4; border-radius: 8px; padding: 18px 35px;">
                                            <p
                                                style="margin: 0 0 7px; color: #6b7280; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">
                                                Verification Code
                                            </p>

                                            <p
                                                style="margin: 0; color: #0f766e; font-size: 32px; font-weight: 700; letter-spacing: 7px;">
                                                <%= otp %>
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <p
                                style="margin: 25px 0 0; color: #6b7280; font-size: 13px; line-height: 20px; text-align: center;">
                                This code will expire in <strong>5 minutes</strong>. Please do not share this code with
                                anyone.
                            </p>

                            <!-- Security Notice -->
                            <div
                                style="margin-top: 25px; padding: 15px; background-color: #f9fafb; border-left: 4px solid #0f766e; border-radius: 4px;">
                                <p style="margin: 0; color: #4b5563; font-size: 12px; line-height: 18px;">
                                    If you did not request a new verification code, you can safely ignore this email.
                                </p>
                            </div>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="padding: 20px 30px; background-color: #f9fafb; border-top: 1px solid #e5e7eb;">
                            <p style="margin: 0 0 6px; color: #6b7280; font-size: 12px;">
                                This is an automated email from CareNest.
                            </p>

                            <p style="margin: 0; color: #9ca3af; font-size: 11px;">
                                © <%= new Date().getFullYear() %> CareNest. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>
</body>

</html>