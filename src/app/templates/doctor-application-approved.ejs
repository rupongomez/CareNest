<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CareNest - Doctor Application Approved</title>
</head>

<body style="
    margin: 0;
    padding: 0;
    background-color: #f4f7f9;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
">

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
            width: 100%;
            background-color: #f4f7f9;
            padding: 40px 16px;
        ">
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
                        max-width: 560px;
                        background-color: #ffffff;
                        border-radius: 12px;
                        overflow: hidden;
                        border: 1px solid #e5e7eb;
                    ">

                    <!-- Header -->
                    <tr>
                        <td style="
                            padding: 28px 32px;
                            border-bottom: 1px solid #e5e7eb;
                        ">
                            <div style="
                                font-size: 24px;
                                font-weight: 700;
                                color: #0f766e;
                                margin-bottom: 4px;
                            ">
                                CareNest
                            </div>

                            <div style="
                                font-size: 13px;
                                color: #6b7280;
                            ">
                                Online Medical Management System
                            </div>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 32px;">

                            <!-- Approval Icon -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center"
                                style="margin-bottom: 24px;">
                                <tr>
                                    <td align="center" valign="middle" style="
                                            width: 64px;
                                            height: 64px;
                                            background-color: #ecfdf5;
                                            border: 1px solid #a7f3d0;
                                            border-radius: 50%;
                                            font-size: 30px;
                                            font-weight: 700;
                                            color: #059669;
                                        ">
                                        ✓
                                    </td>
                                </tr>
                            </table>

                            <!-- Heading -->
                            <h1 style="
                                margin: 0 0 16px;
                                text-align: center;
                                font-size: 26px;
                                line-height: 1.3;
                                font-weight: 700;
                                color: #111827;
                            ">
                                Your Doctor Account Has Been Approved
                            </h1>

                            <!-- Doctor Name -->
                            <p style="
                                margin: 0 0 20px;
                                text-align: center;
                                font-size: 16px;
                                line-height: 1.6;
                                color: #374151;
                            ">
                                Hello Dr. <%= name %>,
                            </p>

                            <!-- Main Message -->
                            <p style="
                                margin: 0;
                                text-align: center;
                                font-size: 16px;
                                line-height: 1.6;
                                color: #374151;
                            ">
                                We're pleased to let you know that your
                                doctor application has been reviewed and
                                approved by the CareNest team.
                            </p>

                            <!-- Approval Notice -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
                                    margin-top: 28px;
                                    background-color: #ecfdf5;
                                    border: 1px solid #a7f3d0;
                                    border-radius: 8px;
                                ">
                                <tr>
                                    <td style="
                                        padding: 20px;
                                        font-size: 14px;
                                        line-height: 1.7;
                                        color: #065f46;
                                    ">
                                        <strong style="
                                            display: block;
                                            margin-bottom: 6px;
                                            font-size: 15px;
                                        ">
                                            Congratulations!
                                        </strong>

                                        Your account is now approved and
                                        you can access the doctor features
                                        available through CareNest.
                                    </td>
                                </tr>
                            </table>

                            <!-- Next Steps -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                                style="margin-top: 28px;">
                                <tr>
                                    <td style="
                                        padding-bottom: 10px;
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: #111827;
                                    ">
                                        What's next?
                                    </td>
                                </tr>

                                <tr>
                                    <td style="
                                        padding: 8px 0;
                                        font-size: 14px;
                                        line-height: 1.6;
                                        color: #6b7280;
                                    ">
                                        ✓ Sign in to your CareNest account
                                    </td>
                                </tr>

                                <tr>
                                    <td style="
                                        padding: 8px 0;
                                        font-size: 14px;
                                        line-height: 1.6;
                                        color: #6b7280;
                                    ">
                                        ✓ Complete and update your professional profile
                                    </td>
                                </tr>

                                <tr>
                                    <td style="
                                        padding: 8px 0;
                                        font-size: 14px;
                                        line-height: 1.6;
                                        color: #6b7280;
                                    ">
                                        ✓ Manage your availability and appointments
                                    </td>
                                </tr>

                                <tr>
                                    <td style="
                                        padding: 8px 0;
                                        font-size: 14px;
                                        line-height: 1.6;
                                        color: #6b7280;
                                    ">
                                        ✓ Start providing care through CareNest
                                    </td>
                                </tr>
                            </table>

                            <!-- Security Notice -->
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="
                                    margin-top: 24px;
                                    background-color: #f9fafb;
                                    border-radius: 8px;
                                ">
                                <tr>
                                    <td style="
                                        padding: 16px;
                                        font-size: 13px;
                                        line-height: 1.6;
                                        color: #6b7280;
                                    ">
                                        <strong style="color: #374151;">
                                            Keep your account secure
                                        </strong>
                                        <br>
                                        Never share your password or account
                                        credentials with anyone.
                                    </td>
                                </tr>
                            </table>

                            <!-- Closing -->
                            <p style="
                                margin: 28px 0 0;
                                padding-top: 24px;
                                border-top: 1px solid #e5e7eb;
                                text-align: center;
                                font-size: 14px;
                                line-height: 1.6;
                                color: #6b7280;
                            ">
                                Thank you for joining CareNest.
                                We look forward to having you as part of
                                our healthcare community.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="
                            padding: 20px 32px;
                            background-color: #f9fafb;
                            text-align: center;
                        ">
                            <p style="
                                margin: 0 0 6px;
                                font-size: 13px;
                                color: #6b7280;
                            ">
                                © <%= new Date().getFullYear() %> CareNest
                            </p>

                            <p style="
                                margin: 0;
                                font-size: 12px;
                                line-height: 1.5;
                                color: #9ca3af;
                            ">
                                This is an automated notification.
                                Please do not reply to this email.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>